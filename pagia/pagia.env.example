# Αντίγραψε το αρχείο ως pagia.env και συμπλήρωσε τις τιμές.
# Το pagia.env ΔΕΝ ανεβαίνει ποτέ στο GitHub.

# Τυχαίο μακρύ κείμενο (τουλάχιστον 40 χαρακτήρες)
SECRET_KEY=

# Ο πρώτος διαχειριστής — άλλαξε τον κωδικό αμέσως μετά την πρώτη σύνδεση
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SCHOOL_NAME=

# Σύνδεση με το Ηλεκτρονικό Πρωτόκολλο (ίδιο NAS, θύρα 5500)
PROTO_URL=http://host.docker.internal:5500
# Ίδια τιμή με το API_KEY του protokollo.env
PROTO_API_KEY=
PROTO_RECIPIENT=Ι.ΝΕ.ΔΙ.ΒΙ.Μ.
PROTO_TIMEOUT=15

DATA_DIR=/data
TEMPLATE_DIR=/data/templates
